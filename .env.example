# Copy to .env and edit for this machine's equipment.

# static     = start indiserver with INDI_DRIVERS at boot (predictable, recommended)
# webmanager = start INDI Web Manager; pick drivers from Ekos or http://<host>:8624
INDI_MODE=static

# Space-separated driver binaries. List what's available with: make drivers
# Default is simulators so the stack can be tested with no hardware attached.
INDI_DRIVERS=indi_simulator_telescope indi_simulator_ccd indi_simulator_focus

# Example: Celestron CGEM + ZWO ASI183MC/ASI220 (one indi_asi_ccd serves both) + ZWO EAF
# INDI_DRIVERS=indi_celestron_gps indi_asi_ccd indi_asi_focuser

INDI_VERBOSE=false

# static mode: connect every device at startup, without waiting for Ekos. Each device is
# retried every 10s for INDI_AUTOCONNECT_TIMEOUT seconds until it connects once.
INDI_AUTOCONNECT=true
INDI_AUTOCONNECT_TIMEOUT=300

# PHD2 runs headless on Xvfb; Ekos connects to it on port 4400.
# Set false to use Ekos' internal guider instead.
ENABLE_PHD2=true
# Build-time: set false to leave PHD2/Xvfb out of the image entirely (rebuild required)
INSTALL_PHD2=true

# Host-side ports (change if another INDI stack already uses them on this machine)
INDI_HOST_PORT=7624
INDI_WEB_HOST_PORT=8624
PHD2_HOST_PORT=4400
